# Code style for the .NET projects in emulator/ (enforced in the build: EnforceCodeStyleInBuild).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,xml,axaml}]
indent_size = 2

[*.cs]
# Layout
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0005.severity = warning

# var everywhere the type is obvious or built in
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
dotnet_diagnostic.IDE0007.severity = warning

# Language preferences the code already follows
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_diagnostic.IDE0003.severity = warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_diagnostic.IDE0049.severity = warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.IDE0035.severity = warning

# Naming (IDE1006 makes the rules below build warnings)
dotnet_diagnostic.IDE1006.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.members.applicable_kinds = property, method, event
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.types_are_pascal.symbols = types
dotnet_naming_rule.types_are_pascal.style = pascal
dotnet_naming_rule.types_are_pascal.severity = warning
dotnet_naming_rule.members_are_pascal.symbols = members
dotnet_naming_rule.members_are_pascal.style = pascal
dotnet_naming_rule.members_are_pascal.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_rule.constants_are_pascal.severity = warning

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_fields_are_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal.style = pascal
dotnet_naming_rule.static_readonly_fields_are_pascal.severity = warning

dotnet_naming_symbols.non_private_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_rule.non_private_fields_are_pascal.symbols = non_private_fields
dotnet_naming_rule.non_private_fields_are_pascal.style = pascal
dotnet_naming_rule.non_private_fields_are_pascal.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_rule.private_fields_are_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel.style = underscore_camel
dotnet_naming_rule.private_fields_are_underscore_camel.severity = warning

dotnet_naming_symbols.local_functions.applicable_kinds = local_function
dotnet_naming_rule.local_functions_are_pascal.symbols = local_functions
dotnet_naming_rule.local_functions_are_pascal.style = pascal
dotnet_naming_rule.local_functions_are_pascal.severity = warning

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_rule.locals_are_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_are_camel.style = camel
dotnet_naming_rule.locals_are_camel.severity = warning

# Quality rules beyond latest-recommended
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA1311.severity = warning
dotnet_diagnostic.CA2213.severity = warning
dotnet_diagnostic.CA1063.severity = warning
dotnet_diagnostic.CA1816.severity = warning
dotnet_diagnostic.CA1852.severity = warning
dotnet_diagnostic.CA1805.severity = warning
dotnet_diagnostic.CA1823.severity = warning
dotnet_diagnostic.CA2007.severity = none

# Sonar way rules (SonarCloud's default profile) that the SonarAnalyzer.CSharp package leaves off
# unless asked: the parameterised ones, with Sonar way's default limits.
dotnet_diagnostic.S107.severity = warning
dotnet_diagnostic.S110.severity = warning
dotnet_diagnostic.S1192.severity = warning
dotnet_diagnostic.S1479.severity = warning
dotnet_diagnostic.S2342.severity = warning
dotnet_diagnostic.S2436.severity = warning
dotnet_diagnostic.S3776.severity = warning
dotnet_diagnostic.S6664.severity = warning
dotnet_diagnostic.S6669.severity = warning

# Tests: method names are sentences (Some_behaviour_is_so), and inline arrays read better than fields.
[{App.Tests,HostProtocol.Tests,KbNotify.Tests,Ssd1306.Tests}/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
# S1192 is a main-code rule (Sonar's MainSourceScope): SonarCloud doesn't raise it on test projects.
dotnet_diagnostic.S1192.severity = none
