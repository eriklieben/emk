<Project>

  <!-- Shared by every project in KbEmulator.slnx. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unnecessary usings) to run in the build; the XML file itself is not used,
         so missing or partial XML docs (CS1591, CS1573) are not warnings. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!-- Warnings are errors for Release builds (./docs-media, publishing) and CI. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' or '$(CI)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Test projects are test code for the SonarScanner (SonarCloud): test rules, not main-code rules. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <SonarQubeTestProject>true</SonarQubeTestProject>
  </PropertyGroup>

  <!-- Sonar's C# rules (the ones SonarCloud runs), as a build-time analyzer only: nothing ships. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
