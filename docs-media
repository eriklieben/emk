#!/usr/bin/env bash
# Render the README's pictures into docs/media/, from the firmware's own code:
#
#   ./docs-media           everything (Rust in the dev container, the .NET app headless on the host)
#   ./docs-media --smoke   check the whole path on a tiny scene; writes only under target/docs-media/
#
# - screen close-ups (*.gif), profiles.png, keymap SVGs: tools/docs-media (kb-emu on a simulated clock)
# - the keyboard animations (kb-*.gif, scene-*.gif), layer and combo pictures (layer-*.png,
#   combo-*.png) and app screenshots (app-*.png): emulator/DocsMedia renders the app's CorneView
#   and windows headless; tools/docs-media turns the frames into GIFs
set -euo pipefail
cd "$(dirname "$0")"

OUT=docs/media
WORK=target/docs-media

./dev cargo build --release -q -p kb-emu -p kb-docs-media
dotnet build emulator/DocsMedia -c Release -v q -nologo -clp:ErrorsOnly >/dev/null
RENDER=(dotnet emulator/DocsMedia/bin/Release/net10.0/EmkDocsMedia.dll)

if [[ "${1:-}" == "--smoke" ]]; then
  rm -rf "$WORK/smoke"
  ./dev cargo test -q -p kb-docs-media
  "${RENDER[@]}" "$WORK/smoke/media" "$WORK/smoke/frames" --smoke
  ./dev target/release/docs-media assemble "$WORK/smoke/frames" "$WORK/smoke/media"
  echo "docs-media: smoke test passed"
  exit 0
fi

rm -rf "$WORK/frames"
mkdir -p "$OUT"
# Everything in docs/media/ is generated: drop what an earlier run wrote, so renamed pictures don't linger.
rm -f "$OUT"/*.gif "$OUT"/*.png "$OUT"/*.svg
echo "OLED animations and keymap:"
./dev sh -c "target/release/docs-media oled $OUT && target/release/docs-media keymap $OUT"
echo "App screenshots:"
"${RENDER[@]}" "$OUT" "$WORK/frames" 2> >(grep -v "^emk: theme" >&2)
echo "Keyboard scenes:"
./dev target/release/docs-media assemble "$WORK/frames" "$OUT"

echo
echo "docs/media:"
total=0
while read -r size path; do
  total=$((total + size))
  note=""
  [[ $path == *.gif && $size -gt 1500000 ]] && note="  (over 1.5 MB)"
  printf '%9d  %s%s\n' "$size" "$path" "$note"
done < <(find "$OUT" -type f -printf '%s %p\n' | sort -k2)
printf '%9d  total%s\n' "$total" "$([[ $total -gt 8000000 ]] && echo '  (over 8 MB)')"
