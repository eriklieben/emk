/.cargo-home/
/build/

# .NET
bin/
obj/
TestResults/
publish/
*.user
*.suo
.vs/

# Node (release tooling: package.json in the root)
node_modules/

# Python
__pycache__/
*.py[cod]
.ruff_cache/
